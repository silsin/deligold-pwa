# Pin the registry for this project.
#
# Why: the committed package-lock.json is generated here and consumed by
# `npm ci` in the Docker build. When a developer's global npm config points at a
# mirror (e.g. registry.npmmirror.com), every `resolved` URL in the lockfile is
# rewritten to that mirror, and the image build then depends on the mirror being
# reachable and complete. Pinning npmjs.org keeps local and container installs
# identical.
registry=https://registry.npmjs.org

# Fail instead of silently resolving a range that has no published version.
save-exact=false
