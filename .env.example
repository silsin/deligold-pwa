# Copy to `.env` and adjust. docker compose reads this file for interpolation
# (the ${VAR} placeholders in docker-compose.yml) — it is NOT passed into the
# container automatically.
#
#   cp .env.example .env && docker compose -f docker-compose.prod.yml up --build -d

# ── Production (docker-compose.prod.yml) ──────────────────────────────────────

# REQUIRED — pick a long random string, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Image tag, useful for pinning a release rather than :latest.
IMAGE_TAG=latest

# Live price feed credentials (akbarigold.ir). Leave blank to use fallback prices.
MARKET_UID=
MARKET_TOKEN=

# ── Development (docker-compose.dev.yml) ──────────────────────────────────────

# Host port for the Vite dev server (HMR).
DEV_PORT=9741

# Where the dev server proxies the API routes. Matches the fallback target in
# vite.config.js (NestJS delly-api on port 7456).
#   Docker Desktop: http://host.docker.internal:7456
#   Linux:          http://172.17.0.1:7456
DG_API_TARGET=http://host.docker.internal:7456

# ── Live price feed (akbarigold.ir) ───────────────────────────────────────────

# The board reads real prices from akbarigold.ir, the same provider the shop's
# own site uses. Both values are REQUIRED — without them /market/board falls
# back to hard-coded indicative numbers and every quote is flagged stale, so the
# app looks like it is working while showing numbers nobody set.
#
# The token is rotated by the upstream periodically. When it expires the feed
# answers HTTP 403 {"msg":"invalid credentials"} and the API logs:
#   price fetch failed ... akbarigold HTTP 403
# The board then degrades to the fallback rather than serving wrong prices
# silently — watch the logs if the numbers stop updating.
#
# These are operator credentials: server-side only, never exposed to the client.
# docker-compose.yml passes them through to the api container from this file.

MARKET_UID=
MARKET_TOKEN=

