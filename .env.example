# Copy to `.env` and adjust. docker compose reads this file for interpolation
# (the ${VAR} placeholders in docker-compose.yml) — it is NOT passed into the
# container automatically.
#
#   cp .env.example .env && docker compose up --build

# ── Production (docker-compose.yml) ───────────────────────────────────────────

# Host port to publish. The container always listens on 9741 (unprivileged, so
# the image also works on Kubernetes); this is the left side of -p.
PORT=9741

# Image tag, useful for pinning a release rather than :latest.
IMAGE_TAG=latest

# Bake the API origin into the bundle at BUILD time. Empty by default, which
# keeps the same-origin relative base ('/') — the right choice when API_UPSTREAM
# proxies the NestJS routes, and equally correct behind an existing reverse proxy.
#
# Uncomment to call an API directly, e.g.:
# VITE_API_URL=https://api.example.com

# Reverse-proxy the NestJS routes at RUNTIME (/auth /users /trade /wallet
# /market /reports /stores /uploads), so the PWA stays same-origin (no CORS) and
# the target can change without a rebuild.
#   Docker Desktop:  http://host.docker.internal:7456
#   Linux:           http://172.17.0.1:7456
#   compose service: http://delly-api:7456
API_UPSTREAM=

# Only relevant when API_UPSTREAM is set. 127.0.0.11 is Docker's embedded DNS.
DNS_RESOLVER=127.0.0.11

# ── Development (docker-compose.dev.yml) ──────────────────────────────────────

# Host port for the Vite dev server (HMR).
DEV_PORT=9741

# Where the dev server proxies the API routes. Matches the fallback target in
# vite.config.js (NestJS delly-api on port 7456).
#   Docker Desktop: http://host.docker.internal:7456
#   Linux:          http://172.17.0.1:7456
DG_API_TARGET=http://host.docker.internal:7456
