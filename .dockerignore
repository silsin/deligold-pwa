# Keep the build context tiny. `dist` is produced inside the image and
# `node_modules` is re-installed there from the lockfile, so shipping either one
# would only bloat the context and risk a stale/foreign-platform install.
# `api/` is a sibling service with its own Dockerfile/context (see compose) —
# it must never be copied into the PWA image.
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
DOCKER.md
node_modules
dist
api

# Local noise / logs
*.log
build-out.txt
build-err.txt
pwa-dev-out.txt
pwa-dev-err.txt
dev-pwa.log
npm-debug.log*

# Secrets & local env (build args come from the shell or compose, not the repo)
.env
.env.*
!.env.example
